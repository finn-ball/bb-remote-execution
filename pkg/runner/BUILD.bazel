# Opt-in kernel tests use a dedicated action executable.
go_test(
    name = "pid_namespace_kernel_test",
    srcs = ["pid_namespace_kernel_linux_test.go"],
    data = ["//pkg/runner/pid_namespace_test_action"],
    embed = [":runner"],
    env = {
        "BB_PID_NAMESPACE_ACTION_RUNFILE_PATH": "$(rlocationpath //pkg/runner/pid_namespace_test_action)",
    },
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@com_github_buildbarn_bb_storage//pkg/clock",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/runfiles",
    ],
)
